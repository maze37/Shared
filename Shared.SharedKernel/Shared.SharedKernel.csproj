<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Mazeland.SharedKernel</PackageId>
    <Version>1.0.0</Version>
    <Authors>Mazeland</Authors>
    <Company>Mazeland</Company>
    <Description>SharedKernel package containing Core and Framework modules for Mazeland projects.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/maze37/Shared</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Core\bin\$(Configuration)\net9.0\Core.dll" Pack="true" PackagePath="lib\net9.0" />
    <None Include="..\Framework\bin\$(Configuration)\net9.0\Framework.dll" Pack="true" PackagePath="lib\net9.0" />
  </ItemGroup>

</Project>