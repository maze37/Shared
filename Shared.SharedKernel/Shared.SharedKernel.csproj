<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Mazeland.SharedKernel</PackageId>
    <Version>1.0.0</Version>
    <Authors>Mazeland</Authors>
    <Company>Mazeland</Company>
    <Description>SharedKernel package containing Core and Framework modules for Mazeland projects.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/maze37/Shared</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\artifacts\bin\Shared.Core\release\Shared.Core.dll" Pack="true" PackagePath="lib\net9.0" />
    <None Include="..\artifacts\bin\Shared.Framework\release\Shared.Framework.dll" Pack="true" PackagePath="lib\net9.0" />
  </ItemGroup>

</Project>